---
import { messagesFor, type Locale } from '../../i18n';
import DemoLink from '../ui/demo-link.astro';
import ProductPreview from '../ui/product-preview.astro';
import BrandText from '../ui/brand-text.astro';
import '../../styles/hero-sky.css';
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const messages = messagesFor(locale);
const titleLines = messages.hero.title.split('\n');
---

<div class="hero-surface">
  <section class="hero container" aria-labelledby="hero-title">
    <div class="copy">
      <h1 id="hero-title">
        {titleLines.map((line) => (
          <span class="title-line">
            <BrandText text={line} locale={locale} />
          </span>
        ))}
      </h1>
      <p class="lede">
        <BrandText text={messages.hero.lede} locale={locale} />
      </p>
      <div class="actions">
        <DemoLink locale={locale} label={messages.nav.demo} />
        <a class="button secondary" href="#request-demo" data-request-kind="demo">
          {messages.nav.contact}
        </a>
      </div>
    </div>
    <ProductPreview locale={locale} />
  </section>
</div>
<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, var(--hero-copy)) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-12);
    max-inline-size: var(--hero-max);
    /* Sized by its content with fixed space around it, whatever the screen height. */
    padding-block: var(--space-12) var(--space-16);
  }
  .copy {
    min-inline-size: 0;
    max-inline-size: var(--hero-copy);
  }
  h1 {
    max-inline-size: var(--hero-title-width);
    font-weight: var(--hero-weight);
    line-height: var(--hero-line-height);
    letter-spacing: var(--hero-tracking);
    text-wrap: balance;
  }
  .title-line {
    display: block;
  }
  :global(html:lang(ar)) h1 {
    max-inline-size: 100%;
    font-size: var(--text-hero-ar);
  }
  /* Large enough to hold its own beside the art, while the title still leads. */
  .lede {
    margin-block-start: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-marketing-muted);
    /* Even line lengths without justifying: justified text opens uneven gaps between words. */
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
  }
  /* Side by side, the art sits on the outer edge, in line with the header bar's edge. */
  @media (min-width: 64rem) {
    .hero :global(.reading-preview) {
      margin-inline: auto 0;
    }
    /* The title sets the column's width; the description fills exactly that width, so both share one edge. */
    .copy {
      inline-size: fit-content;
    }
    /* Justified only here: three short, nearly full lines, so the added space per gap stays a few pixels.
       The widget's text-alignment option still turns it off for visitors who need ragged text. */
    .lede {
      contain: inline-size;
      text-align: justify;
      text-align-last: start;
    }
  }
  .hero :global(.button:not(.secondary)) {
    border-color: var(--color-brand);
    box-shadow: var(--shadow-hero-cta);
  }
  @media (max-width: 63.9375rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .copy {
      max-inline-size: var(--reading-max);
    }
  }
  @media (max-width: 39.9375rem) {
    .hero {
      padding-block: var(--space-10) var(--space-16);
    }
    .actions :global(.button) {
      flex: 1 1 auto;
    }
  }
</style>
