---
import { messagesFor, type Locale } from '../../i18n';
import DemoLink from '../ui/demo-link.astro';
import ProductPreview from '../ui/product-preview.astro';
import FeatureMarquee from '../ui/feature-marquee.astro';
import BrandText from '../ui/brand-text.astro';
import '../../styles/hero-sky.css';
import '../../styles/hero-product.css';
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const messages = messagesFor(locale);
const titleLines = messages.hero.title.split('\n');
---

<div class="hero-surface">
  <section class="hero container" aria-labelledby="hero-title">
    <div class="copy">
      <h1 id="hero-title">
        {titleLines.map((line) => (
          <span class="title-line">
            <BrandText text={line} locale={locale} />
          </span>
        ))}
      </h1>
      <p class="lede">
        <BrandText text={messages.hero.lede} locale={locale} />
      </p>
      <div class="actions">
        <DemoLink locale={locale} label={messages.nav.demo} />
      </div>
    </div>
    <div class="hero-product">
      <ProductPreview locale={locale} />
    </div>
    <FeatureMarquee locale={locale} />
  </section>
</div>
<style>
  /* A centred hero: a large title, the description and the demo button, then the three features side by side. */
  .hero {
    display: grid;
    /* One column that never grows past the page: the feature strip's moving track is far wider than the screen. */
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: var(--space-6);
    max-inline-size: var(--hero-max);
    padding-block: var(--space-10);
    text-align: center;
  }
  .copy {
    display: grid;
    justify-items: center;
    max-inline-size: var(--hero-centre-copy);
  }
  /* Spacing by grouping: the title, text and buttons sit close as one message; the cards stand further off. */
  .hero-product {
    margin-block-start: var(--space-6);
  }
  h1 {
    margin: 0;
    font-size: var(--text-hero-centre);
    font-weight: var(--hero-weight);
    line-height: var(--hero-line-height);
    letter-spacing: var(--hero-tracking);
    text-wrap: balance;
  }
  :global(html:lang(ar)) h1 {
    font-size: var(--text-hero-centre-ar);
  }
  .title-line {
    display: block;
  }
  .lede {
    max-inline-size: 62rem;
    margin-block-start: var(--space-4);
    color: var(--color-marketing-muted);
    font-size: var(--text-md);
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }
  .hero :global(.button:not(.secondary)) {
    border-color: var(--color-brand);
    box-shadow: var(--shadow-hero-cta);
  }
  @media (max-width: 39.9375rem) {
    .hero {
      gap: var(--space-8);
      padding-block: var(--space-6) var(--space-12);
    }
    .actions {
      inline-size: 100%;
    }
    .actions :global(.button) {
      flex: 1 1 auto;
    }
  }
</style>
