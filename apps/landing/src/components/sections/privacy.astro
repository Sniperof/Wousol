---
import { messagesFor, type Locale } from '../../i18n';
import BrandText from '../ui/brand-text.astro';
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const words = messagesFor(locale).privacy;
---

<section class="section privacy" aria-labelledby="privacy-title">
  <div class="container privacy-layout">
    <div class="intro">
      <div class="heading">
        <span class="shield" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" focusable="false">
            <path d="M12 3 4 6v5c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6Z" />
            <path d="m8.5 11.5 2.5 2.5 4.5-4.5" />
          </svg>
        </span>
        <h2 id="privacy-title">
          <BrandText text={words.title} locale={locale} />
        </h2>
      </div>
      <p>
        <BrandText text={words.body} locale={locale} />
      </p>
    </div>
    <ul role="list">
      {words.points.map((point) => (
        <li>
          <span class="check" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" focusable="false">
              <path d="m7.5 12 3 3 6-6" />
            </svg>
          </span>
          <span>
            <BrandText text={point} locale={locale} />
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .privacy {
    background: var(--color-hero-surface);
    color: var(--color-hero-ink);
  }
  .privacy-layout {
    display: grid;
    align-items: center;
    gap: var(--space-8);
  }
  .intro {
    min-inline-size: 0;
  }
  .heading {
    display: grid;
    align-items: center;
    gap: var(--space-4);
    margin-block-end: var(--space-4);
  }
  h2,
  p {
    margin: 0;
  }
  .shield,
  .check {
    display: grid;
    place-items: center;
    background: var(--color-surface);
    color: var(--color-brand);
  }
  .shield {
    inline-size: var(--space-16);
    block-size: var(--space-16);
    border-radius: var(--radius-lg);
  }
  svg {
    stroke: currentColor;
    stroke-width: var(--illustration-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .shield svg {
    inline-size: var(--space-10);
    block-size: var(--space-10);
  }
  p {
    color: var(--color-marketing-muted);
  }
  ul {
    display: grid;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
    min-inline-size: 0;
  }
  li {
    display: grid;
    grid-template-columns: var(--space-10) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-4);
    font-weight: var(--weight-medium);
    overflow-wrap: anywhere;
  }
  .check {
    inline-size: var(--space-10);
    block-size: var(--space-10);
    border-radius: var(--radius-full);
  }
  .check svg {
    inline-size: var(--icon-size);
    block-size: var(--icon-size);
  }
  @media (min-width: 64rem) {
    .privacy-layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--space-12);
    }
    .heading {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }
</style>
