---
import { messagesFor, type Locale } from '../../i18n';
import { featureScenes } from '../../character/scenes';
import Character from '../ui/character.astro';
import BrandText from '../ui/brand-text.astro';
import '../../styles/card-grid.css';
import '../../styles/visitor-cards.css';
import '../../styles/visitor-sample.css';
import '../../styles/swipe-dots.css';
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const words = messagesFor(locale).visit;
---

<section id="features" class="section container" aria-labelledby="features-title">
  <div class="section-heading">
    <h2 id="features-title">
      <BrandText text={words.title} locale={locale} />
    </h2>
  </div>
  <ul class="card-grid visitor-grid need-grid" role="list" aria-labelledby="features-title">
    {words.cards.map((card, index) => (
      <li id={`feature-${featureScenes[index] ?? 'reading'}`} class="visitor-card aligned-card">
        <Character scene={featureScenes[index] ?? featureScenes[0]} />
        <h3>
          <BrandText text={card.title} locale={locale} />
        </h3>
        <div class="visitor-description">
          <p>
            <BrandText text={card.body} locale={locale} />
          </p>
          <p class="need-helps">{card.helps}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
<script>
  import { startSwipeRow } from '../../swipe/row';
  document.querySelectorAll<HTMLElement>('.need-grid').forEach((row) => startSwipeRow(row));
</script>
<style>
  .section {
    padding-block-start: calc(var(--space-16) * var(--features-top-space-scale));
  }
  .need-grid {
    --card-min: var(--solution-card-min);
    --feature-art-compact: 5.5rem;
  }
  .need-grid > li {
    padding: var(--space-5);
    background: var(--color-card-tint);
  }
  /* The description fills its row, so who it helps and the link always sit at the bottom of the card. */
  .visitor-description {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    block-size: 100%;
  }
  .need-helps {
    align-self: start;
    margin-block-start: auto;
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) solid var(--color-card-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-size: var(--text-sm);
  }
  /* Wide screens: three cards, then two wider ones, trimmed so the section fits one laptop screen. */
  @media (min-width: 64rem) {
    .section {
      padding-block: var(--space-8);
    }
    .section :global(.section-heading) {
      margin-block-end: var(--space-5);
    }
    .need-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--space-4);
    }
    .need-grid > li {
      row-gap: var(--space-3);
      padding: var(--space-4);
    }
    .need-grid > li > :global(.character-scene) {
      block-size: var(--feature-art-compact);
    }
    .need-grid > li {
      grid-column: span 2;
    }
    /* The two wide cards set the drawing beside the text, which keeps the section close to one screen tall. */
    .need-grid > li:nth-child(n + 4) {
      grid-column: span 3;
      grid-row: auto;
      grid-template-columns: var(--character-art-width) minmax(0, 1fr);
      /* Titles share one line at the top; the "who it helps" boxes share one line at the bottom. */
      grid-template-rows: auto 1fr;
      column-gap: var(--space-5);
    }
    /* Both "who it helps" boxes are the same size: the full text width and two lines tall,
       even when the text needs only one line, so their tops line up too. */
    .need-grid > li:nth-child(n + 4) .need-helps {
      align-self: stretch;
      display: flex;
      align-items: center;
      min-block-size: calc(2lh + 2 * var(--space-1) + 2 * var(--border-width));
    }
    .need-grid > li:nth-child(n + 4) > :global(.character-scene) {
      grid-area: 1 / 1 / 3 / 2;
      align-self: center;
    }
    .need-grid > li:nth-child(n + 4) > h3 {
      grid-area: 1 / 2;
    }
    .need-grid > li:nth-child(n + 4) > .visitor-description {
      grid-area: 2 / 2;
    }
  }
  /* Tablets: a lone last card takes the whole row instead of leaving a gap beside it. */
  @media (min-width: 48rem) and (max-width: 63.9375rem) {
    .need-grid > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  /* Phones: the cards become one row to swipe, a full card and the edge of the next in view. */
  @media (max-width: 47.9375rem) {
    .section {
      padding-block-start: calc(var(--space-12) * var(--features-top-space-scale));
    }
    .need-grid {
      grid-template-columns: none;
      grid-template-rows: repeat(3, auto);
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      gap: var(--space-4);
      margin-inline: calc(-1 * var(--space-4));
      padding: var(--space-1) var(--space-4) var(--space-3);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--space-4);
    }
    .need-grid > li {
      scroll-snap-align: start;
    }
  }
</style>
