---
import { messagesFor, type Locale } from '../../i18n';
import EnquiryForm from './enquiry-form.astro';
import { demoSalesEmail } from '../../config/contact';
import { enquiryHref } from '../../pricing/enquiry';
import BrandText from '../ui/brand-text.astro';
import '../../styles/invitation.css';
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const messages = messagesFor(locale);
---

<section
  id="request-demo"
  class="section container invitation"
  aria-labelledby="final-title"
  data-demo-contact
>
  <div class="invitation-card">
    <h2 id="final-title">
      <BrandText text={messages.final.title} locale={locale} />
    </h2>
    <button
      type="button"
      class="button open-form"
      data-needs-dialog
      data-request-kind="demo"
      hidden
    >
      {messages.nav.contact}
    </button>
    <EnquiryForm locale={locale} />
    <p class="reply-line">
      <BrandText text={messages.final.reply} locale={locale} />
    </p>
    <p class="email-line">
      {messages.final.email}
      <span data-demo-email>
        <a href={enquiryHref(demoSalesEmail, messages.final.subject)} dir="ltr">
          {demoSalesEmail}
        </a>
      </span>
    </p>
  </div>
</section>
