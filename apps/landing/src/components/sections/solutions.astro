---
import { messagesFor, type Locale } from '../../i18n';
import DemoLink from '../ui/demo-link.astro';
import SolutionVisual from '../ui/solution-visual.astro';
import BrandText from '../ui/brand-text.astro';
import '../../styles/card-grid.css';
import '../../styles/solutions.css';
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const words = messagesFor(locale).solutions;
---

<section id="solutions" class="section container solutions" aria-labelledby="solutions-title">
  <div class="section-heading">
    <h2 id="solutions-title">
      <BrandText text={words.title} locale={locale} />
    </h2>
    <p>
      <BrandText text={words.intro} locale={locale} />
    </p>
  </div>
  <div class="solutions-grid card-grid">
    {words.cards.map((card) => (
      <article class="solution-card aligned-card">
        <SolutionVisual locale={locale} kind={card.kind} />
        <h3>
          <BrandText text={card.title} locale={locale} />
        </h3>
        <p>
          <BrandText text={card.body} locale={locale} />
        </p>
        {card.kind === 'widget' ? (
          <DemoLink locale={locale} label={card.action} secondary />
        ) : (
          <a
            class="button secondary"
            href="#request-demo"
            data-pricing-action={card.kind === 'services' || undefined}
            data-request-kind={card.kind === 'tailored' ? 'demo' : undefined}
          >
            {card.action}
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </article>
    ))}
  </div>
</section>
