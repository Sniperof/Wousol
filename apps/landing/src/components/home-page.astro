---
import type { Locale } from '../i18n';
import Pricing from './sections/pricing.astro';
import Hero from './sections/hero.astro';
import Solutions from './sections/solutions.astro';
import Features from './sections/features.astro';
import Installation from './sections/installation.astro';
import Privacy from './sections/privacy.astro';
import FinalInvitation from './sections/final-invitation.astro';
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
---

<Hero locale={locale} />
<Solutions locale={locale} />
<Features locale={locale} />
<Pricing locale={locale} />
<Installation locale={locale} />
<Privacy locale={locale} />
<FinalInvitation locale={locale} />
