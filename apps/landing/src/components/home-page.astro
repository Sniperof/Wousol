---
import type { Locale } from '../i18n';
import Hero from './sections/hero.astro';
import Features from './sections/features.astro';
import SignLanguage from './sections/sign-language.astro';
import Benefits from './sections/benefits.astro';
import Installation from './sections/installation.astro';
import Dashboard from './sections/dashboard.astro';
import Pricing from './sections/pricing.astro';
import FinalInvitation from './sections/final-invitation.astro';
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
---

<Hero locale={locale} />
<Features locale={locale} />
<SignLanguage locale={locale} />
<Benefits locale={locale} />
<Installation locale={locale} />
<Dashboard locale={locale} />
<Pricing locale={locale} />
<FinalInvitation locale={locale} />
