---
import { homePathOf, messagesFor, otherLocale, type Locale } from '../../i18n';
import { demoSalesEmail } from '../../config/contact';
import { enquiryHref } from '../../pricing/enquiry';
import Brand from '../ui/brand.astro';
import BrandText from '../ui/brand-text.astro';
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const messages = messagesFor(locale);
const other = otherLocale(locale);
---

<footer class="footer">
  <div class="footer-content container">
    <div class="footer-top">
      <div class="footer-brand">
        <Brand locale={locale} tone="white" />
        <p>
          <BrandText text={messages.footer.about} locale={locale} />
        </p>
      </div>
      <div class="footer-reach">
        <p class="contact">
          <a href="#request-demo" data-request-kind="demo">
            {messages.nav.contact}
          </a>
          <span aria-hidden="true">·</span>
          <a href={enquiryHref(demoSalesEmail, messages.final.subject)} dir="ltr">
            {demoSalesEmail}
          </a>
        </p>
        <p class="badge">{messages.footer.badge}</p>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="byline">
        <BrandText text={messages.footer.byline} locale={locale} />
        <span aria-hidden="true">·</span>
        <BrandText text={messages.footer.copyright} locale={locale} />
        <span aria-hidden="true">·</span>
        <a href={homePathOf(other)} lang={other} hreflang={other}>
          {messagesFor(other).languageName}
        </a>
      </span>
      <p>
        <BrandText text={messages.footer.note} locale={locale} />
      </p>
    </div>
  </div>
</footer>
<style>
  /* One compact primary-blue band: who we are and how to reach us on one row, the byline and note under a rule. */
  .footer {
    --brand-word-color: var(--color-brand-text);
    --color-text: var(--color-brand-text);
    --color-link: var(--color-brand-text);
    --color-focus: var(--color-brand-text);
    color: var(--color-brand-text);
    background: var(--color-brand);
  }
  .footer-content {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8) var(--space-6);
  }
  .footer-top,
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3) var(--space-8);
  }
  .footer-brand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }
  .footer p {
    margin: 0;
  }
  .footer-brand p {
    max-inline-size: 40ch;
    color: var(--color-footer-muted);
  }
  .footer-reach {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-2);
  }
  .badge {
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) solid var(--color-footer-rule);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
  }
  .footer :global(a) {
    color: var(--color-brand-text);
    text-decoration: none;
  }
  .footer :global(a:hover) {
    text-decoration: underline;
  }
  .footer-bottom {
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-footer-rule);
    font-size: var(--text-sm);
  }
  .byline {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-weight: var(--weight-strong);
  }
  .footer-bottom p {
    max-inline-size: 60ch;
    color: var(--color-footer-muted);
  }
  /* Phones: the page's floating accessibility button sits in the end corner, so the last line wraps clear of it. */
  @media (max-width: 47.9375rem) {
    .footer-content {
      gap: var(--space-4);
      padding-block: var(--space-6) var(--space-5);
    }
    .footer-bottom p {
      padding-inline-end: calc(var(--space-16) + var(--space-4));
    }
  }
</style>
