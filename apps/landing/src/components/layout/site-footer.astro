---
import { homePathOf, messagesFor, otherLocale, type Locale } from '../../i18n';
import { pricingWords } from '../../i18n/pricing';
import { demoSalesEmail } from '../../config/contact';
import { enquiryHref } from '../../pricing/enquiry';
import Brand from '../ui/brand.astro';
import BrandText from '../ui/brand-text.astro';
import DemoLink from '../ui/demo-link.astro';
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const messages = messagesFor(locale);
const other = otherLocale(locale);
---

<footer class="footer">
  <div class="footer-content container">
    <div class="footer-top">
      <div class="footer-brand">
        <Brand locale={locale} />
        <p>
          <BrandText text={messages.footer.about} locale={locale} />
        </p>
        <p class="contact">
          <a href="#request-demo" data-request-kind="demo">
            {messages.nav.contact}
          </a>
          <span aria-hidden="true">·</span>
          <a href={enquiryHref(demoSalesEmail, messages.final.subject)} dir="ltr">
            {demoSalesEmail}
          </a>
        </p>
        <p class="badge">{messages.footer.badge}</p>
      </div>
      <nav aria-label={messages.footer.navLabel}>
        <a href="#features">{messages.nav.features}</a>
        <a href="#sign-language">{messages.nav.signLanguage}</a>
        <a href="#installation">{messages.nav.installation}</a>
        <a href="#dashboard">{messages.nav.dashboard}</a>
        <a href="#pricing" data-pricing-nav hidden>
          {pricingWords(locale).nav}
        </a>
        <DemoLink locale={locale} label={messages.nav.liveDemo} plain />
      </nav>
    </div>
  </div>
  <div class="footer-strip">
    <div class="footer-bottom container">
      <span class="byline">
        <BrandText text={messages.footer.byline} locale={locale} />
        <span aria-hidden="true">·</span>
        <BrandText text={messages.footer.copyright} locale={locale} />
        <span aria-hidden="true">·</span>
        <a href={homePathOf(other)} lang={other} hreflang={other}>
          {messagesFor(other).languageName}
        </a>
      </span>
      <p>
        <BrandText text={messages.footer.note} locale={locale} />
      </p>
    </div>
  </div>
</footer>
<style>
  /* A light top with blue text, a rule above it, and the primary-blue strip closing the page below. */
  .footer {
    --brand-word-color: var(--color-brand);
    --color-text: var(--color-brand);
    --color-link: var(--color-brand);
    color: var(--color-brand);
    border-block-start: var(--border-width) solid var(--color-card-border);
  }
  .footer-content {
    padding-block: var(--space-12) var(--space-10);
  }
  .footer-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-8);
  }
  .footer-brand {
    display: grid;
    gap: var(--space-3);
  }
  .footer-brand p {
    max-inline-size: 36ch;
    margin: 0;
  }
  .footer-brand .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-2);
  }
  .footer-brand .badge {
    justify-self: start;
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) solid var(--color-card-active-border);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }
  .footer :global(a) {
    color: currentColor;
    text-decoration: none;
  }
  .footer :global(a:hover) {
    text-decoration: underline;
  }
  [data-pricing-nav][hidden] {
    display: none;
  }
  .footer-strip {
    --brand-word-color: var(--color-brand-text);
    --color-text: var(--color-brand-text);
    --color-link: var(--color-brand-text);
    --color-focus: var(--color-brand-text);
    color: var(--color-brand-text);
    background: var(--color-brand);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3) var(--space-8);
    padding-block: var(--space-6) var(--space-24);
    font-size: var(--text-sm);
  }
  .byline {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-weight: var(--weight-strong);
  }
  .footer-bottom p {
    max-inline-size: 52ch;
    margin: 0;
    color: var(--color-footer-muted);
  }
</style>
