---
import { homePathOf, messagesFor, otherLocale, type Locale } from '../../i18n';
import { pricingWords } from '../../i18n/pricing';
import '../../styles/site-header.css';
import '../../styles/header-autohide.css';
import Brand from '../ui/brand.astro';
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const messages = messagesFor(locale);
const other = otherLocale(locale);
---

<header class="site-header container" data-site-header>
  <Brand locale={locale} />
  <nav id="site-navigation" class="site-nav" aria-label={messages.nav.label}>
    <a href="#features">{messages.nav.features}</a>
    <a href="#sign-language">{messages.nav.signLanguage}</a>
    <a href="#installation">{messages.nav.installation}</a>
    <a href="#dashboard">{messages.nav.dashboard}</a>
    <a href="#pricing" data-pricing-nav hidden>
      {pricingWords(locale).nav}
    </a>
  </nav>
  <a class="site-language" href={homePathOf(other)} lang={other} hreflang={other}>
    {messagesFor(other).languageName}
  </a>
  <a id="site-request" class="button site-request" href="#request-demo" data-request-kind="demo">
    {messages.nav.contact}
  </a>
  <button
    class="button secondary site-menu-toggle"
    type="button"
    aria-label={messages.nav.menu}
    aria-controls="site-navigation site-request"
    aria-expanded="false"
    data-site-menu
    hidden
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path class="menu-open" d="M4 6h16M4 12h16M4 18h16"></path>
      <path class="menu-close" d="m6 6 12 12M6 18 18 6"></path>
    </svg>
  </button>
</header>
<script>
  import { mountSiteNavigation } from '../../navigation/site-navigation';
  import { autoHideHeader } from '../../navigation/header-visibility';
  mountSiteNavigation();
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) autoHideHeader(header);
</script>
