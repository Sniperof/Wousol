---
import '../../styles/interpreter-preview.css';
import '../../styles/interpreter-motion.css';
---

<div class="interpreter-preview" role="img" aria-hidden="true">
  <svg viewBox="0 0 168 116" fill="none">
    <rect class="call-frame" x="1" y="1" width="166" height="114" rx="16" />
    <path class="call-grid" d="M1 86H167" />
    <ellipse class="person-shadow" cx="74" cy="104" rx="43" ry="5" />
    <path class="interpreter-shirt" d="M39 104V79c0-17 13-27 35-27s35 10 35 27v25" />
    <path class="interpreter-face" d="M61 42h26v20c-6 7-20 7-26 0V42Z" />
    <g class="interpreter-head" data-animate>
      <ellipse class="interpreter-face" cx="74" cy="31" rx="19" ry="23" />
      <path
        class="interpreter-hair"
        d="M55 30c-4-15 3-25 18-25 15 0 24 10 20 27l-6-15c-11 7-20 5-27 3l-5 10Z"
      />
      <path class="face-detail" d="M66 31h1m14 0h1m-12 13q4 3 8 0" />
    </g>
    <g class="gesture-arm gesture-first" data-animate>
      <path class="arm-sleeve" d="M45 76 39 91 61 79" />
      <g class="gesture-hand" data-animate>
        <path
          class="interpreter-hand"
          d="m58 81 7-12-2-9q0-4 3-4l4 10 3-15q1-4 4-2l-1 17 6-13q2-3 4-1l-4 16 6-7q3-2 4 1L81 81 69 88Z"
        />
      </g>
    </g>
    <g class="gesture-arm gesture-second" data-animate>
      <path class="arm-sleeve" d="m103 76 5 16-23-11" />
      <g class="gesture-hand" data-animate>
        <path
          class="interpreter-hand"
          d="m88 81-6-10 1-10q0-4-3-4l-3 10-3-14q-1-3-4-1l1 16-5-10q-2-3-4-1l4 15-5-5q-3-1-3 2l10 14 10 5Z"
        />
      </g>
    </g>
    <g class="remote-person">
      <rect class="remote-frame" x="119" y="12" width="38" height="45" rx="9" />
      <circle class="remote-face" cx="138" cy="28" r="7" />
      <path class="remote-shirt" d="M126 49v-5c0-6 5-9 12-9s12 3 12 9v5" />
    </g>
    <path class="frame-detail" d="M15 14h12m-12 5h7M128 96h23" />
  </svg>
</div>
