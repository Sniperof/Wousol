---
import type { Locale } from '../../i18n';
import type { Group } from '../../i18n/messages';
import BrandText from './brand-text.astro';
import '../../styles/card-grid.css';
import '../../styles/visitor-cards.css';
interface Props {
  readonly id: string;
  readonly locale: Locale;
  readonly title: string;
  readonly intro?: string;
  readonly cards: readonly Group[];
  /** Sets the section on the soft hero surface, to separate it from its neighbours. */
  readonly band?: boolean;
}
const { id, locale, title, intro, cards, band = false } = Astro.props;
---

<section id={id} class:list={['section info-section', { band }]} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="section-heading">
      <h2 id={`${id}-title`}>
        <BrandText text={title} locale={locale} />
      </h2>
      {intro && (
        <p>
          <BrandText text={intro} locale={locale} />
        </p>
      )}
    </div>
    <ul class="card-grid visitor-grid info-grid" role="list">
      {cards.map((card) => (
        <li class="visitor-card aligned-card">
          <h3>
            <BrandText text={card.title} locale={locale} />
          </h3>
          <p>
            <BrandText text={card.body} locale={locale} />
          </p>
        </li>
      ))}
    </ul>
    <div class="info-after">
      <slot />
    </div>
  </div>
</section>
<style>
  .band {
    background: var(--color-hero-surface);
    color: var(--color-hero-ink);
  }
  .info-grid {
    --card-min: var(--benefit-card-min);
    --card-rows: 2;
  }
  .info-after {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    margin-block-start: var(--space-8);
    text-align: center;
  }
  .info-after:empty {
    display: none;
  }
  .info-after :global(p) {
    margin: 0;
    color: var(--color-marketing-muted);
    font-size: var(--text-sm);
  }
</style>
