---
import type { Locale } from '../../i18n';
import type { Group } from '../../i18n/messages';
import BrandText from './brand-text.astro';
import '../../styles/card-grid.css';
import '../../styles/visitor-cards.css';
interface Props {
  readonly id: string;
  readonly locale: Locale;
  readonly title: string;
  readonly intro?: string;
  readonly cards: readonly Group[];
  /** Sets the section on the soft hero surface, to separate it from its neighbours. */
  readonly band?: boolean;
  /** Puts the heading beside a single column of cards; `end` moves the cards to the start side. */
  readonly split?: 'start' | 'end';
}
const { id, locale, title, intro, cards, band = false, split } = Astro.props;
---

<section
  id={id}
  class:list={['section info-section', { band }]}
  data-split={split}
  aria-labelledby={`${id}-title`}
>
  <div class="container info-layout">
    <div class="section-heading">
      <h2 id={`${id}-title`}>
        <BrandText text={title} locale={locale} />
      </h2>
      {intro && (
        <p>
          <BrandText text={intro} locale={locale} />
        </p>
      )}
    </div>
    <ul class="card-grid visitor-grid info-grid" role="list">
      {cards.map((card) => (
        <li class="visitor-card aligned-card">
          <h3>
            <BrandText text={card.title} locale={locale} />
          </h3>
          <p>
            <BrandText text={card.body} locale={locale} />
          </p>
        </li>
      ))}
    </ul>
    <div class="info-after">
      <slot />
    </div>
  </div>
</section>
<style>
  .info-grid {
    --card-min: var(--benefit-card-min);
    --card-rows: 2;
  }
  .info-after {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    margin-block-start: var(--space-8);
    text-align: center;
  }
  .info-after:empty {
    display: none;
  }
  .info-after :global(p) {
    margin: 0;
    color: var(--color-marketing-muted);
    font-size: var(--text-sm);
  }
  @media (min-width: 64rem) {
    [data-split] .info-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      grid-template-areas: 'heading cards' 'after cards';
      grid-template-rows: auto 1fr;
      column-gap: var(--space-16);
    }
    [data-split='end'] .info-layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      grid-template-areas: 'cards heading' 'cards after';
    }
    [data-split] .section-heading {
      grid-area: heading;
      margin: 0;
      text-align: start;
    }
    [data-split] .section-heading p {
      margin-inline: 0;
    }
    [data-split] .info-grid {
      --card-min: 100%;
      grid-area: cards;
    }
    [data-split] .info-after {
      grid-area: after;
      align-content: start;
      justify-items: start;
      text-align: start;
    }
  }
</style>
