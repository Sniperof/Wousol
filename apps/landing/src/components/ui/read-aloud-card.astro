---
import { messagesFor, type Locale } from '../../i18n';
import { pricingFeatures } from '../../i18n/pricing';
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const words = messagesFor(locale).preview;
---

<div class="preview-card voice-card" data-animate>
  <p class="voice-title">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M11 4 5 9H2v6h3l6 5V4ZM15 8a6 6 0 0 1 0 8M18 5a10 10 0 0 1 0 14" />
    </svg>
    {pricingFeatures(locale)['read-aloud']}
  </p>
  <svg class="voice-wave" viewBox="0 0 160 32" role="img" aria-hidden="true">
    {[12, 22, 16, 30, 18, 26, 10, 20, 14, 28, 16, 24, 12].map((height, index) => (
      <rect
        x={index * 12 + 2}
        y={(32 - height) / 2}
        width="5"
        height={height}
        rx="2.5"
        style={`--i: ${String(index)}`}
        data-animate
      />
    ))}
  </svg>
  <button
    class="button secondary voice-play"
    data-voice-play
    type="button"
    aria-pressed="false"
    disabled
  >
    <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8 4v16l13-8Z" />
    </svg>
    <svg class="stop-icon" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="5" y="5" width="14" height="14" rx="2" />
    </svg>
    <span data-voice-button-label>{words.voice.play}</span>
  </button>
  <p class="voice-status" data-voice-status role="status"></p>
</div>
