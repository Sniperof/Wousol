---
import { enquiryWords } from '../../i18n/enquiry';
import { messagesFor, type Locale } from '../../i18n';
import { demoSalesEmail } from '../../config/contact';
import { enquiryHref } from '../../pricing/enquiry';
import BrandText from './brand-text.astro';

/** The request dialog's side panel: its title, when the team replies, the privacy facts, and the email fallback. */
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const words = enquiryWords(locale);
const page = messagesFor(locale);
---

<aside class="enquiry-aside">
  <h3 id="enquiry-title">{words.title}</h3>
  <p>
    <BrandText text={page.final.reply} locale={locale} />
  </p>
  <p class="enquiry-badge">{page.footer.badge}</p>
  <p class="enquiry-mail">
    {words.alternative}
    <span data-demo-email>
      <a href={enquiryHref(demoSalesEmail, page.final.subject)} dir="ltr">
        {demoSalesEmail}
      </a>
    </span>
  </p>
</aside>
